# Lakehouse Freedom settings for the local OpenLakehouse stack.
# Copied to stack/.env by `make openlakehouse-configure` (the stack's .env is gitignored).
# These are local demo credentials, the same defaults OpenLakehouse ships. Change them
# for anything beyond a laptop.
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=lakehouse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=lakehouse_s3
S3_SECRET_KEY=lakehouse_s3_secret
S3_BUCKET=lakehouse
S3_WAREHOUSE=s3a://lakehouse/warehouse
ICEBERG_WAREHOUSE=${S3_WAREHOUSE}

AIRFLOW_ADMIN_USER=freedom
AIRFLOW_ADMIN_PASSWORD=freedom
AIRFLOW_FERNET_KEY=
JUPYTER_TOKEN=freedom-local-only
